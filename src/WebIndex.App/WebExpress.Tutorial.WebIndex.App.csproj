<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Version>2.0.1-alpha</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' != 'DebugLocal'">
		<PackageReference Include="WebExpress.WebApp" Version="2.0.1-alpha" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebIndex\WebExpress.Tutorial.WebIndex.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<PackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</PackageRoot>
	</PropertyGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
		<Exec Command="&quot;$(TargetDir)$(AssemblyName).exe&quot; -s &quot;$(PackageRoot)\WebExpress.Tutorial.WebIndex.spec&quot; -c $(Configuration) -t $(TargetFramework) -o &quot;$(PackageRoot)\pkg\$(Configuration)&quot;" />
	</Target>

	<ItemGroup>
		<None Update="settings/webexpress.settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
